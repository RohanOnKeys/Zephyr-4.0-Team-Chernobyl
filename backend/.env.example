PORT=5000

# Neon Postgres connection string. This is the application database - all
# users, quests, completions, flashcards and inventory live here.
# Get it from the Neon dashboard (use the POOLED connection string).
# Run `npm run migrate` after setting it to create the schema.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Firebase is used for AUTHENTICATION ONLY (verifying ID tokens).
# Firestore is not used; application data is in Postgres above.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional. A GitHub personal access token (no scopes needed) raises the
# GitHub API rate limit and unlocks the contribution streak/calendar data.
# Without it, GitHub stats still work but skip streak/total contributions.
GITHUB_TOKEN=

# Optional. SMTP credentials for habit reminder emails. Without these,
# reminders still work in-browser (Notification API) but no email is sent.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASS=an App Password (not your normal password) from
# https://myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Free API key from https://api.imgbb.com/ used to host flashcard
# images. Kept server-side on purpose - never expose this as a VITE_ variable.
# Without it, flashcards still work but image upload returns 503.
IMGBB_API_KEY=
